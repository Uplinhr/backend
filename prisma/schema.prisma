// prisma/schema.prisma - Esquema completo con todos los modelos
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Planes de membresía mensuales (Start, Growth, Premium, Custom)
model MembershipPlan {
  id           String   @id @default(cuid())
  code         String   @unique // START, GROWTH, PREMIUM, CUSTOM
  name         String
  priceMonthly Float
  currency     String   @default("USD")
  creditsPerMonth Int
  rolloverMonths  Int   @default(0) // 0 = no acumulables
  benefits     Json?
  // Integración con pasarelas
  mpProductId  String?
  paypalPlanId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions MembershipSubscription[]

  @@map("membership_plans")
}

// Suscripción del usuario a un plan de membresía
model MembershipSubscription {
  id               String             @id @default(cuid())
  userId           String
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  canceledAt       DateTime?
  suspendedAt      DateTime?
  nextBillingAt    DateTime
  lastChargedAt    DateTime?
  lastChargeResult ChargeResult?
  retryAttempts    Int                @default(0)
  maxRetryAttempts Int                @default(3)
  retryIntervalHrs Int                @default(24)
  graceDays        Int                @default(7)
  metadata         Json?
  // Identificadores externos para conciliación
  externalCustomerId     String?
  externalSubscriptionId String?
  lastExternalChargeId   String?

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MembershipPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@map("membership_subscriptions")
}

// Perfil de usuario (datos personales extendidos)
model UserProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  documentType   String?
  documentNumber String?
  dateOfBirth    DateTime?
  country        String?
  state          String?
  city           String?
  address        String?
  postalCode     String?
  jobTitle       String?
  seniority      String?
  linkedinUrl    String?
  website        String?
  preferences    Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// Perfil de empresa del usuario (B2B)
model CompanyProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  companyName  String
  companyEmail String?
  companyPhone String?
  taxId        String?
  industry     String?
  companySize  String?
  country      String?
  state        String?
  city         String?
  address      String?
  postalCode   String?
  website      String?
  linkedinUrl  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

// Identidades externas (OAuth/OIDC)
model UserIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  rawProfile     Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId, provider])
  @@map("user_identities")
}

// Notificaciones transaccionales
model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  status    NotificationStatus @default(PENDING)
  subject   String
  body      String?
  metadata  Json?
  sentAt    DateTime?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("notifications")
}

enum NotificationType {
  ACCOUNT_WELCOME
  PASSWORD_RESET
  PLAN_PURCHASE
  TALENT_SEARCH_UPDATE
  CONSULTATION_UPDATE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo User (integración con Auth0)
model User {
  id               String       @id @default(cuid())
  auth0Id          String?      @unique // Para integración con Auth0
  email            String       @unique
  name             String?
  provider         AuthProvider @default(MAGIC_LINK)
  emailVerified    Boolean      @default(false)
  profileCompleted Boolean      @default(false)
  firstName        String?
  lastName         String?
  fullName         String?
  pictureUrl       String?
  locale           String?
  phone            String?
  role             Role         @default(CLIENTE) // Enum para roles
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  // Relaciones
  transactions            Transaction[]
  plans                   UserPlan[]
  consultants             Consultant[]             @relation("UserConsultants")
  credits                 Credit[]
  consultations           Consultation[]
  planPurchases           PlanPurchase[]
  empresas                Empresa[]
  shoppingCarts           ShoppingCart[]
  paymentOrders           PaymentOrder[]
  auditLogs               PaymentAuditLog[]
  passwordResets          PasswordReset[]
  // Nuevas relaciones Auth0/Profile
  profile                 UserProfile?
  company                 CompanyProfile?
  identities              UserIdentity[]
  notifications           Notification[]
  membershipSubscriptions MembershipSubscription[]

  @@map("users")
}

// Modelo Plan/Subscription
model Plan {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  currency    String   @default("USD")
  features    Json? // Para características flexibles
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  subscriptions UserPlan[]
  transactions  Transaction[]
  purchases     PlanPurchase[]

  @@map("plans")
}

// Modelo Transaction/Payment
model Transaction {
  id                   String            @id @default(cuid())
  userId               String
  planId               String?
  amount               Float
  currency             String            @default("USD")
  status               TransactionStatus @default(PENDING)
  gateway              PaymentGateway
  gatewayTransactionId String? // ID de la pasarela (MP, PayPal, etc.)
  metadata             Json? // Datos adicionales encriptados
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relaciones
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id])

  @@map("transactions")
}

// Modelo TaxConfig
model TaxConfig {
  id        String   @id @default(cuid())
  name      String // Nombre del impuesto
  rate      Float // Tasa (ej: 0.21 para 21%)
  country   String? // País aplicable
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tax_configs")
}

// Modelo Consultant
model Consultant {
  id         String   @id @default(cuid())
  userId     String // Relacionado con User
  name       String
  email      String
  phone      String?
  bio        String?
  skills     Json? // Habilidades como array
  hourlyRate Float?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relaciones
  user User @relation("UserConsultants", fields: [userId], references: [id])

  @@map("consultants")
}

// Modelo TalentSearchService
model TalentSearchService {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  currency    String   @default("USD")
  category    String? // Categoría del servicio
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("talent_search_services")
}

// Modelo Credit (créditos de usuarios)
model Credit {
  id         String     @id @default(cuid())
  userId     String
  type       CreditType
  amount     Int // Cantidad de créditos
  expiryDate DateTime?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relaciones
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  searches  Search[]
  purchases CreditPurchase[]

  @@map("credits")
}

// Modelo Search (búsquedas de talento)
model Search {
  id          String       @id @default(cuid())
  creditId    String
  searchInfo  Json // Información de la búsqueda
  creditsUsed Int          @default(1)
  status      SearchStatus @default(PENDING)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relaciones
  credit Credit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@map("searches")
}

// Modelo Consultation (consultorías/horas de consulta)
model Consultation {
  id             String    @id @default(cuid())
  userId         String
  totalHours     Int // Horas totales contratadas
  remainingHours Int // Horas restantes
  expiryDate     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relaciones
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions ConsultationSession[]

  @@map("consultations")
}

// Modelo ConsultationSession (sesiones individuales de consultoría)
model ConsultationSession {
  id             String             @id @default(cuid())
  consultationId String
  startTime      DateTime
  endTime        DateTime?
  duration       Int? // Duración en minutos
  cost           Float? // Costo de la sesión
  paymentMethod  String?
  notes          String?
  status         ConsultationStatus @default(SCHEDULED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relaciones
  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_sessions")
}

// Modelo Empresa (datos de empresas de usuarios)
model Empresa {
  id           String   @id @default(cuid())
  userId       String?
  name         String
  email        String
  fantasyName  String?
  cuit         String?
  taxCondition String?
  legalType    String?
  mainActivity String?
  legalStreet  String?
  legalCity    String?
  legalCountry String?
  postalCode   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  user User? @relation(fields: [userId], references: [id])

  @@map("empresas")
}

// Modelo ShoppingCart (carrito de compras)
model ShoppingCart {
  id             String     @id @default(cuid())
  cartUuid       String     @unique
  userId         String?
  sessionId      String?
  status         CartStatus @default(active)
  currency       String     @default("USD")
  countryCode    String?
  expiresAt      DateTime?
  convertedAt    DateTime?
  subtotal       Float?
  taxAmount      Float?
  discountAmount Float?
  totalAmount    Float?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relaciones
  user   User?          @relation(fields: [userId], references: [id])
  items  CartItem[]
  orders PaymentOrder[]

  @@map("shopping_cart")
}

// Modelo CartItem (items del carrito)
model CartItem {
  id                 String   @id @default(cuid())
  cartId             String
  itemType           String
  itemId             String?
  itemName           String
  quantity           Int      @default(1)
  unitPrice          Float
  discountPercentage Float?   @default(0)
  taxRate            Float?   @default(0)
  subtotal           Float
  taxAmount          Float?   @default(0)
  total              Float
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relaciones
  cart ShoppingCart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

// Modelo CreditPurchase (compras de créditos)
model CreditPurchase {
  id            String   @id @default(cuid())
  creditId      String
  amount        Float // Costo de la compra
  paymentMethod String
  notes         String?
  createdAt     DateTime @default(now())

  // Relaciones
  credit Credit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@map("credit_purchases")
}

// Modelo PlanPurchase (compras de planes)
model PlanPurchase {
  id            String   @id @default(cuid())
  userId        String
  planId        String
  amount        Float // Precio pagado
  paymentMethod String // Medio de pago
  notes         String?
  createdAt     DateTime @default(now())

  // Relaciones
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@map("plan_purchases")
}

// Modelo UserPlan (para suscripciones de usuarios)
model UserPlan {
  id        String    @id @default(cuid())
  userId    String
  planId    String
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  // Relaciones
  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@unique([userId, planId, startDate])
  @@map("user_plans")
}

// Enums para seguridad y consistencia
enum Role {
  ADMINISTRADOR
  CLIENTE
}

// Proveedor de autenticación
enum AuthProvider {
  GOOGLE
  LINKEDIN
  MAGIC_LINK
  EMAIL_PASSWORD
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentGateway {
  MERCADO_PAGO
  PAYPAL
  PAYONEER
}

// Estado de suscripción de membresías
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

// Intento de cobro del ciclo
enum ChargeResult {
  SUCCESS
  FAILED
  PENDING
}

enum CreditType {
  PLAN // Créditos que vienen con un plan
  PURCHASE // Créditos comprados adicionalmente
  BONUS // Créditos de regalo/bonus
}

enum SearchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Estados del carrito de compras
enum CartStatus {
  active
  converted
  expired
  abandoned
}

// Estados de órdenes/transacciones de pago
enum PaymentStatus {
  pending
  initiated
  completed
  failed
  cancelled
  refunded
  captured
}

// Órdenes de pago (equivalente a payment_orders)
model PaymentOrder {
  id                String        @id @default(cuid())
  orderNumber       String        @unique @map("order_number")
  userId            String?       @map("id_usuario")
  cartId            String?       @map("id_cart")
  status            PaymentStatus
  paymentGateway    String        @map("payment_gateway")
  currency          String        @default("USD")
  subtotal          Float?
  taxAmount         Float?        @map("tax_amount")
  discountAmount    Float?        @map("discount_amount")
  totalAmount       Float?        @map("total_amount")
  countryCode       String?       @map("country_code")
  taxRate           Float?        @map("tax_rate")
  taxName           String?       @map("tax_name")
  paymentMethod     String?       @map("payment_method")
  externalPaymentId String?       @map("external_payment_id")
  paymentUrl        String?       @map("payment_url")
  expiresAt         DateTime?     @map("expires_at")
  customerEmail     String?       @map("customer_email")
  customerName      String?       @map("customer_name")
  billingAddress    Json?         @map("billing_address")
  notes             String?
  createdAt         DateTime      @default(now()) @map("fecha_alta")
  paidAt            DateTime?     @map("paid_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  refundedAt        DateTime?     @map("refunded_at")
  updatedAt         DateTime      @updatedAt

  // Relaciones
  user         User?                @relation(fields: [userId], references: [id])
  cart         ShoppingCart?        @relation(fields: [cartId], references: [id])
  transactions PaymentTransaction[] @relation("OrderTransactions")
  auditLogs    PaymentAuditLog[]

  @@map("payment_orders")
}

// Transacciones de pago (equivalente a payment_transactions)
model PaymentTransaction {
  id                   String        @id @default(cuid())
  transactionId        String        @unique @map("transaction_id")
  orderId              String        @map("id_order")
  status               PaymentStatus
  paymentGateway       String        @map("payment_gateway")
  gatewayTransactionId String?       @map("gateway_transaction_id")
  gatewayStatus        String?       @map("gateway_status")
  gatewayResponse      Json?         @map("gateway_response")
  amount               Float
  currency             String        @default("USD")
  gatewayFee           Float?        @map("gateway_fee")
  netAmount            Float?        @map("net_amount")
  paymentMethod        String?       @map("payment_method")
  cardLastFour         String?       @map("card_last_four")
  cardBrand            String?       @map("card_brand")
  errorCode            String?       @map("error_code")
  errorMessage         String?       @map("error_message")
  processedAt          DateTime?     @map("processed_at")
  ipAddress            String?       @map("ip_address")
  userAgent            String?       @map("user_agent")
  createdAt            DateTime      @default(now()) @map("fecha_alta")
  updatedAt            DateTime      @updatedAt

  // Relaciones
  order     PaymentOrder      @relation("OrderTransactions", fields: [orderId], references: [id], onDelete: Cascade)
  auditLogs PaymentAuditLog[]

  @@map("payment_transactions")
}

// Log de auditoría de pagos (equivalente a payment_audit_log)
model PaymentAuditLog {
  id               String   @id @default(cuid())
  orderId          String?  @map("id_order")
  transactionId    String?  @map("id_transaction")
  userId           String?  @map("id_usuario")
  eventType        String   @map("event_type")
  eventDescription String?  @map("event_description")
  performedBy      String?  @map("performed_by")
  performedByType  String?  @map("performed_by_type")
  oldValue         Json?    @map("old_value")
  newValue         Json?    @map("new_value")
  metadata         Json?
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  createdAt        DateTime @default(now()) @map("fecha_alta")

  // Relaciones
  order       PaymentOrder?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  transaction PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("payment_audit_log")
}

// Reinicio de contraseña (equivalente a reinicio_contrasenia)
model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime @map("fecha_exp")
  userId    String?  @map("id_usuario")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("fecha_alta")

  user User? @relation(fields: [userId], references: [id])

  @@map("reinicio_contrasenia")
}
