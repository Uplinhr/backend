# Database Configuration (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/uplin_db?schema=public"

# Server Configuration
SERVER_PORT=4000
DEV=true
ALLOWED_ORIGINS=http://localhost:3000

# JWT Configuration
JWT_SECRET=your_jwt_secret_here

# Email Configuration (Resend)
MAIL_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@example.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# ===================================
# PAYMENT GATEWAYS CONFIGURATION
# ===================================

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=your_mp_access_token
MERCADOPAGO_PUBLIC_KEY=your_mp_public_key

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox  # Use 'live' for production

# Payoneer
PAYONEER_CLIENT_ID=your_payoneer_client_id
PAYONEER_CLIENT_SECRET=your_payoneer_client_secret
PAYONEER_API_URL=https://api.payoneer.com

# ===================================
# SECURITY CONFIGURATION
# ===================================

# Encryption (must be 32 characters minimum)
ENCRYPTION_KEY=your_encryption_key_32_characters_minimum

# Webhook Secret for signature validation
WEBHOOK_SECRET=your_webhook_secret_key

# ===================================
# AUTH0 CONFIGURATION
# ===================================
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://uplin.api
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_REDIRECT_URI=http://localhost:3000/auth/callback
AUTH0_LOGOUT_REDIRECT_URI=http://localhost:3000

# ===================================
# BILLING / MEMBERSHIPS AUTOMATION
# ===================================
# Cron schedule for billing job (default: every day at 03:00)
BILLING_CRON=0 3 * * *
BILLING_TIMEZONE=America/Argentina/Buenos_Aires
BILLING_MAX_RETRIES=3
BILLING_RETRY_INTERVAL_HRS=24
BILLING_GRACE_DAYS=7

# ===================================
# PAYMENT GATEWAYS (Memberships Auto-debit)
# ===================================
# MercadoPago
MP_ACCESS_TOKEN=your_mp_access_token
MP_WEBHOOK_SECRET=optional_if_used

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# Webhook Base URL (your backend URL)
WEBHOOK_BASE_URL=http://localhost:4000/api/webhooks

# ===================================
# CLOUDINARY (Profile Images)
# ===================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=avatars
